locals {
  # YAML strings
  yaml_strings = concat(
    flatten([
      for dir in var.yaml_directories : [
        for file in fileset(".", "${dir}/*.{yml,yaml}") : file(file)
      ]
    ]),
    [for file in var.yaml_files : file(file)]
  )

  # Defaults YAML (module defaults — user overrides merged inside function)
  defaults_yaml = file("${path.module}/defaults/defaults.yaml")

  # File templates (path -> content), referenced by `file` in network and device templates
  template_models = concat(
    [for s in local.yaml_strings : provider::utils::yaml_decode(s)],
    [var.model]
  )
  template_file_paths = distinct(compact(flatten([
    for m in local.template_models : [
      for k in ["networks", "devices"] : try([for t in m.meraki.templates[k] : try(t.file, null)], [])
    ]
  ])))
  file_templates = { for f in local.template_file_paths : f => file("${path.root}/${f}") }

  # Render model (merge, defaults, network and device templates)
  rendered = provider::utils::render_meraki_model(
    local.yaml_strings,
    var.model,
    local.defaults_yaml,
    local.file_templates
  )

  model    = local.rendered.resolved
  defaults = local.rendered.defaults
  meraki   = try(local.model.meraki, {})
}

resource "local_sensitive_file" "model" {
  count    = var.write_model_file != "" ? 1 : 0
  content  = "# Generated by terraform-meraki-nac-meraki from the data model, do not edit\n${provider::utils::yaml_encode(local.rendered.raw)}"
  filename = var.write_model_file
}

resource "local_sensitive_file" "defaults" {
  count    = var.write_default_values_file != "" ? 1 : 0
  content  = provider::utils::yaml_encode({ defaults = local.defaults })
  filename = var.write_default_values_file
}

moved {
  from = module.model.local_sensitive_file.model
  to   = local_sensitive_file.model
}

moved {
  from = module.model.local_sensitive_file.defaults
  to   = local_sensitive_file.defaults
}
